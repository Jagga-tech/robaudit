{
  "name": "keel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "stdb:start": "spacetime start",
    "stdb:publish": "spacetime publish keel --server local --yes --delete-data=always",
    "stdb:gen": "spacetime generate --lang typescript --out-dir packages/bindings/src --module-path spacetimedb",
    "agent": "pnpm --filter @keel/agent start",
    "demo": "tsx scripts/demo.ts",
    "test:convex": "vitest run convex/test"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2",
    "vitest": "^2.1.0",
    "@keel/ledger-client": "workspace:*"
  },
  "dependencies": {
    "convex": "^1.48.0",
    "ws": "^8.22.0"
  }
}
