{
  "name": "keel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "stdb:start": "spacetime start",
    "stdb:publish": "spacetime publish keel-local --server local --yes --delete-data=always",
    "stdb:gen": "spacetime generate --lang typescript --out-dir packages/bindings/src --module-path spacetimedb",
    "agent": "pnpm --filter @keel/agent start",
    "demo": "tsx scripts/demo.ts",
    "bench": "tsx scripts/bench.ts",
    "test:convex": "vitest run convex/test",
    "eval": "PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval -c eval/promptfooconfig.yaml -o eval/results.json --no-cache --no-table",
    "eval:view": "PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo view"
  },
  "devDependencies": {
    "@keel/ledger-client": "workspace:*",
    "@types/node": "^20.17.0",
    "@types/ws": "^8.18.2",
    "promptfoo": "^0.121.20",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "convex": "^1.48.0",
    "ws": "^8.22.0"
  }
}
