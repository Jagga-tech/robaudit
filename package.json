{
  "name": "keel",
  "private": true,
  "packageManager": "pnpm@9",
  "scripts": {
    "test": "pnpm -r --if-present test",
    "stdb:start": "spacetime start",
    "stdb:publish": "spacetime publish keel --server local --yes --delete-data=always",
    "stdb:gen": "spacetime generate --lang typescript --out-dir packages/bindings/src --module-path spacetimedb",
    "agent": "pnpm --filter @keel/agent start",
    "demo": "tsx scripts/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2",
    "vitest": "^2.1.0"
  }
}
